---
interface Props {
	image: string;
	alt: string;
	description: string;
	href?: string;
}

const { image, alt, description, href } = Astro.props;
---

<div class="project-card bg-dark border-gray transition-all">
	<img src={image} alt={alt} class="w-full block" />
	<div class="border-t-gray flex items-stretch relative">
		<p class="p-4 md:p-6 pr-0 flex-1 leading-relaxed">{description}</p>
		<div
			class:list={[
				"flex justify-center items-start shrink-0",
				href ? "p-2 md:p-4" : "p-5 md:p-7",
			]}
		>
			{
				href ? (
					<a
						href={href}
						target="_blank"
						rel="noopener noreferrer"
						class="group hover:text-[#ff581b] transition-all"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="64"
							height="64"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="butt"
							stroke-linejoin="butt"
							class="transition-transform group-hover:-translate-y-1 group-hover:translate-x-1"
						>
							<line x1="7" y1="17" x2="17" y2="7" />
							<polyline points="7 7 17 7 17 17" />
						</svg>
					</a>
				) : (
					<a target="_blank" class="group hover:text-[#ff581b] transition-all">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="48"
							height="48"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="lucide lucide-traffic-cone preview-icon"
						>
							<path d="M16.05 10.966a5 2.5 0 0 1-8.1 0" />
							<path d="m16.923 14.049 4.48 2.04a1 1 0 0 1 .001 1.831l-8.574 3.9a2 2 0 0 1-1.66 0l-8.574-3.91a1 1 0 0 1 0-1.83l4.484-2.04" />
							<path d="M16.949 14.14a5 2.5 0 1 1-9.9 0L10.063 3.5a2 2 0 0 1 3.874 0z" />
							<path d="M9.194 6.57a5 2.5 0 0 0 5.61 0" />
						</svg>
					</a>
				)
			}
			<svg
				style="bottom: -1px; right: -1px"
				class="absolute pointer-events-none"
				width="51.25"
				height="51.25"
				viewBox="0 0 50 50"
				xmlns="http://www.w3.org/2000/svg"
			>
				<polygon points="0,50 50,0 50,50" fill="#3a3a3a"></polygon>
			</svg>
		</div>
	</div>
</div>
